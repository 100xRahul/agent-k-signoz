{
    "alert": "checkout-p99-latency",
    "alertType": "TRACES_BASED_ALERT",
    "ruleType": "threshold_rule",
    "version": "v5",
    "evalWindow": "1m",
    "frequency": "1m",
    "condition": {
        "compositeQuery": {
            "queryType": "builder",
            "panelType": "graph",
            "queries": [
                {
                    "type": "builder_query",
                    "spec": {
                        "name": "A",
                        "signal": "traces",
                        "stepInterval": "60s",
                        "aggregations": [
                            {"expression": "p99(duration_nano)", "alias": "p99_latency"}
                        ],
                        "filter": {"expression": "service.name = 'checkout'"}
                    }
                }
            ]
        },
        "op": "above",
        "target": 1500000000,
        "matchType": "at_least_once",
        "selectedQueryName": "A"
    },
    "labels": {
        "severity": "warning",
        "service": "checkout",
        "scenario": "bad-deploy"
    },
    "annotations": {
        "summary": "Checkout p99 latency exceeds 1.5s",
        "description": "The checkout service p99 latency is above 1.5 seconds, indicating a performance regression."
    }
}

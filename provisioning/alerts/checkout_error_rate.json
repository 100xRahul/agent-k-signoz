{
    "alert": "checkout-error-rate",
    "alertType": "TRACES_BASED_ALERT",
    "ruleType": "threshold_rule",
    "version": "v5",
    "evalWindow": "1m",
    "frequency": "1m",
    "condition": {
        "compositeQuery": {
            "queryType": "builder",
            "panelType": "graph",
            "queries": [
                {
                    "type": "builder_query",
                    "spec": {
                        "name": "A",
                        "signal": "traces",
                        "stepInterval": "60s",
                        "aggregations": [
                            {"expression": "countIf(has_error = true)", "alias": "error_count"}
                        ],
                        "filter": {"expression": "service.name = 'checkout'"}
                    }
                }
            ]
        },
        "op": "above",
        "target": 10,
        "matchType": "at_least_once",
        "selectedQueryName": "A"
    },
    "labels": {
        "severity": "critical",
        "service": "checkout",
        "scenario": "bad-deploy"
    },
    "annotations": {
        "summary": "Checkout errors exceed 10/min",
        "description": "The checkout service is failing more than 10 requests per minute, possibly due to a bad deployment."
    }
}

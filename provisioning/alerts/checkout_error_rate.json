{
    "alert": "checkout-error-rate",
    "alertType": "TRACES_BASED_ALERT",
    "ruleType": "threshold_rule",
    "version": "v5",
    "evalWindow": "1m",
    "frequency": "1m",
    "condition": {
        "compositeQuery": {
            "queryType": "builder",
            "panelType": "graph",
            "queries": [
                {
                    "type": "builder_query",
                    "spec": {
                        "name": "A",
                        "signal": "traces",
                        "stepInterval": "60s",
                        "limit": 10000,
                        "aggregations": [
                            {"expression": "countIf(has_error = true)", "alias": "errors"}
                        ],
                        "filter": {"expression": "service.name = 'checkout'"},
                        "disabled": true
                    }
                },
                {
                    "type": "builder_query",
                    "spec": {
                        "name": "B",
                        "signal": "traces",
                        "stepInterval": "60s",
                        "limit": 10000,
                        "aggregations": [
                            {"expression": "count()", "alias": "total"}
                        ],
                        "filter": {"expression": "service.name = 'checkout'"},
                        "disabled": true
                    }
                },
                {
                    "type": "builder_formula",
                    "spec": {
                        "name": "F1",
                        "expression": "A * 100 / B",
                        "disabled": false,
                        "limit": 100
                    }
                }
            ]
        },
        "op": "above",
        "target": 10,
        "targetUnit": "percent",
        "matchType": "at_least_once",
        "selectedQueryName": "F1"
    },
    "labels": {
        "severity": "critical",
        "service": "checkout",
        "scenario": "bad-deploy"
    },
    "annotations": {
        "summary": "Checkout error rate exceeds 10%",
        "description": "The checkout service error rate (countIf(has_error)/count * 100) exceeded 10% for 1 minute — likely a bad deployment or flag regression."
    }
}

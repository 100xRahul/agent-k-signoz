{
    "alert": "payment-timeouts",
    "alertType": "TRACES_BASED_ALERT",
    "ruleType": "threshold_rule",
    "version": "v5",
    "evalWindow": "1m",
    "frequency": "1m",
    "condition": {
        "compositeQuery": {
            "queryType": "builder",
            "panelType": "graph",
            "queries": [
                {
                    "type": "builder_query",
                    "spec": {
                        "name": "A",
                        "signal": "traces",
                        "stepInterval": "60s",
                        "aggregations": [
                            {"expression": "count()", "alias": "timeout_errors"}
                        ],
                        "filter": {"expression": "service.name = 'payment' AND has_error = true"}
                    }
                }
            ]
        },
        "op": "above",
        "target": 5,
        "matchType": "at_least_once",
        "selectedQueryName": "A"
    },
    "labels": {
        "severity": "critical",
        "service": "payment",
        "scenario": "pool-exhaustion"
    },
    "annotations": {
        "summary": "Payment errors exceed 5/min",
        "description": "The payment service is timing out or erroring, possibly due to database connection pool exhaustion."
    }
}

{
    "alert": "agentk-budget-spike",
    "alertType": "METRICS_BASED_ALERT",
    "ruleType": "threshold_rule",
    "condition": {
        "compositeQuery": {
            "queryType": "builder",
            "builderQueries": {
                "A": {
                    "dataSource": "metrics",
                    "queryName": "A",
                    "aggregateOperator": "rate",
                    "aggregateAttribute": {
                        "key": "agentk.cost.usd",
                        "type": "Sum"
                    },
                    "expression": "A",
                    "disabled": false,
                    "stepInterval": 60
                }
            }
        },
        "op": ">",
        "target": 2.0,
        "matchType": "1"
    },
    "evalWindow": "5m0s",
    "labels": {
        "severity": "warning",
        "service": "agent-k"
    },
    "annotations": {
        "summary": "Agent K LLM cost exceeds $2/hour budget",
        "description": "Agent K's LLM spending rate has exceeded the $2/hour budget threshold. The agent may be stuck in a loop or investigating too aggressively."
    }
}

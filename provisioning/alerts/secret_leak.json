{
    "alert": "secret-leak-detected",
    "alertType": "LOGS_BASED_ALERT",
    "ruleType": "threshold_rule",
    "version": "v5",
    "evalWindow": "1m",
    "frequency": "1m",
    "condition": {
        "compositeQuery": {
            "queryType": "builder",
            "panelType": "graph",
            "queries": [
                {
                    "type": "builder_query",
                    "spec": {
                        "name": "A",
                        "signal": "logs",
                        "stepInterval": "60s",
                        "aggregations": [
                            {"expression": "count()", "alias": "leak_count"}
                        ],
                        "filter": {"expression": "(body REGEXP 'AKIA[0-9A-Z]{16}' OR body CONTAINS 'BEGIN RSA PRIVATE KEY') AND deployment.environment = 'production'"}
                    }
                }
            ]
        },
        "op": "above_or_equal",
        "target": 1,
        "matchType": "at_least_once",
        "selectedQueryName": "A"
    },
    "labels": {
        "severity": "critical",
        "scenario": "secret-leak"
    },
    "annotations": {
        "summary": "AWS access key pattern detected in production logs",
        "description": "A string matching an AWS access key ID pattern (AKIA...) appeared in production logs. Immediate rotation may be required."
    }
}

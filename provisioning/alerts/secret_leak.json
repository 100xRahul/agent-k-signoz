{
    "alert": "secret-leak-detected",
    "alertType": "LOGS_BASED_ALERT",
    "ruleType": "threshold_rule",
    "condition": {
        "compositeQuery": {
            "queryType": "builder",
            "builderQueries": {
                "A": {
                    "dataSource": "logs",
                    "queryName": "A",
                    "aggregateOperator": "count",
                    "aggregateAttribute": {
                        "key": "",
                        "type": "tag",
                        "dataType": "string"
                    },
                    "filters": {
                        "items": [
                            {
                                "key": {"key": "body", "type": "tag", "dataType": "string"},
                                "op": "regex",
                                "value": "AKIA[0-9A-Z]{16}"
                            },
                            {
                                "key": {"key": "deployment.environment", "type": "resource", "dataType": "string"},
                                "op": "=",
                                "value": "production"
                            }
                        ],
                        "op": "AND"
                    },
                    "expression": "A",
                    "disabled": false,
                    "stepInterval": 60
                }
            }
        },
        "op": ">=",
        "target": 1,
        "matchType": "1"
    },
    "evalWindow": "1m0s",
    "labels": {
        "severity": "critical",
        "scenario": "secret-leak"
    },
    "annotations": {
        "summary": "Potential AWS secret key leaked in production logs",
        "description": "A log entry matching the AWS AKIA key pattern was detected in production. Immediate investigation required."
    }
}

# === LLM Provider (OpenAI-compatible) ===
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# LLM cost accounting (per million tokens) — adjust for your provider/model
LLM_INPUT_PRICE_PER_MTOK=0.15
LLM_OUTPUT_PRICE_PER_MTOK=0.60

# === SigNoz ===
# API key: create in SigNoz UI → Settings → API Keys after first boot
SIGNOZ_API_KEY=your-signoz-api-key-here
# Browser-facing URL for deep links in reports
SIGNOZ_URL=http://localhost:8080

# === Slack ===
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# === Agent K ===
AGENT_PUBLIC_URL=http://localhost:9000
APPROVAL_SECRET=change-me-to-a-random-secret
AUTO_APPROVE=false
MAX_ITERATIONS=20
MAX_COST_USD_PER_INVESTIGATION=1.00
